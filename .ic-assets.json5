[
  {
    "match": "**/*",
    "cache": {
      "max_age": 86400
    },
    "headers": {
      "Content-Security-Policy": "default-src 'self' https://*.icp0.io https://*.ic0.app; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://*.icp0.io https://*.ic0.app; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://*.icp0.io https://*.ic0.app http://localhost:8000 http://127.0.0.1:8000 ws://localhost:3000 ws://127.0.0.1:3000"
    }
  }
]